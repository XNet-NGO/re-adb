<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles -->
    <style name="TextHeader">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextSectionHeader">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <style name="TextHelp">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>
    
    <style name="TextStatus">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <style name="TextRouteSummary">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    
    <!-- Input styles -->
    <style name="InputField" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:background">@color/background_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:singleLine">true</item>
    </style>
    
    <!-- Button styles -->
    <style name="ButtonPrimary" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:background">@color/background_tertiary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
    
    <style name="ButtonSecondary" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@color/background_tertiary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
    
    <style name="ButtonSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:background">@color/background_tertiary</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>
    
    <style name="ButtonStartStop" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
