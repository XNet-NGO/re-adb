<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- ===== TOP: Tunnels & ports (fixed height, static) ===== -->
    <LinearLayout
        android:id="@+id/tunnelSection"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:orientation="vertical"
        android:background="@color/background_secondary">

        <!-- Header row: title + status + start/stop button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/background_elevated"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:elevation="2dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tunnels &amp; ports"
                style="@style/TextHeader"/>
            
            <TextView
                android:id="@+id/tunnelStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                style="@style/TextStatus"
                android:paddingHorizontal="12dp"
                android:text="Stopped"/>
            
            <Button 
                android:id="@+id/btnStartStop"
                style="@style/ButtonStartStop"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:text="Start" 
                android:textColor="@color/accent_green"/>
        </LinearLayout>

        <!-- Tunnel config + saved routes list (built in code by TunnelPanel) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">
            
            <LinearLayout
                android:id="@+id/routeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- Divider between tunnel section and terminal -->
    <View 
        android:layout_width="match_parent" 
        android:layout_height="1dp"
        android:background="@color/divider_medium"/>

    <!-- ===== Alpine terminal (fills remaining space) ===== -->
    <FrameLayout
        android:id="@+id/terminalSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        
        <org.xnet.readb.terminal.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"/>
        
        <!-- Bootstrap overlay (first-run Alpine setup progress) -->
        <ScrollView
            android:id="@+id/bootstrapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:visibility="gone">
            
            <TextView
                android:id="@+id/bootstrapLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#C8E6C9"
                android:textSize="12sp"
                android:padding="16dp"/>
        </ScrollView>
    </FrameLayout>

    <!-- Extra keys row for terminal (ESC, TAB, CTRL, ALT, arrows, etc.) -->
    <LinearLayout
        android:id="@+id/extraKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/key_background"/>

</LinearLayout>
