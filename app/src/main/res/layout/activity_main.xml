<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- ===== Tunnels & ports header (title + status + start/stop) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_elevated"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tunnels &amp; ports"
            style="@style/TextHeader"/>

        <TextView
            android:id="@+id/tunnelStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            style="@style/TextStatus"
            android:paddingHorizontal="12dp"
            android:text="Stopped"/>

        <Button
            android:id="@+id/btnStartStop"
            style="@style/ButtonStartStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:textColor="@color/accent_green"/>
    </LinearLayout>

    <!-- ===== Routes list + tunnel form — fills the screen ===== -->
    <!-- Takes all remaining vertical space (weight=1). A ScrollView wrapper
         means that when the keyboard is up (or the multi-hop form is expanded
         taller than the viewport) the fields remain reachable — the focused
         EditText is scrolled into view — while with the keyboard down
         everything fits without visible scrolling. -->
    <ScrollView
        android:id="@+id/routeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_secondary"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/routeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"/>
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_medium"/>

    <!-- ===== One-shot Alpine prompt (compact, fixed) ===== -->
    <LinearLayout
        android:id="@+id/promptSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_secondary"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- command input + Run -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="alpine$"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:paddingEnd="8dp"/>

            <EditText
                android:id="@+id/cmdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="run a command…"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="text|textNoSuggestions"
                android:imeOptions="actionGo"
                android:maxLines="1"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/btnRun"
                style="@style/ButtonStartStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Run"
                android:textColor="@color/accent_green"/>
        </LinearLayout>

        <!-- small output / confirmation window (fixed height, scrolls only if
             a single command overflows; the common case is a short line) -->
        <ScrollView
            android:id="@+id/cmdOutputScroll"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="6dp"
            android:background="@color/background_primary"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/cmdOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:text=""/>
        </ScrollView>
    </LinearLayout>

    <!-- Bootstrap overlay (first-run Alpine setup progress) -->
    <ScrollView
        android:id="@+id/bootstrapOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/bootstrapLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#C8E6C9"
            android:textSize="12sp"
            android:padding="16dp"/>
    </ScrollView>

</LinearLayout>
